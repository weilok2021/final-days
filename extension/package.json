{
  "name": "final-days-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Final Days for Chrome and Edge: once a day, the page goes dark and shows how many days you have left.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "check": "tsc -p tsconfig.check.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "icons": "node scripts/mkicon.mjs",
    "e2e": "node --test \"e2e/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/chrome": "^0.2.8",
    "@types/node": "^26.4.1",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2"
  }
}
